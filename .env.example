# ─────────────────────────────────────────────────────────────────────────────
# SWSuite — copy to .env and edit before first run:  cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Where the suite is reachable ─────────────────────────────────────────────
# The portal is served on PORTAL_PORT; every app publishes its own port below,
# so the whole suite works over a plain IP address with no DNS at all.
#
# Later, point NGINX Proxy Manager at host:port for each app, then flip
# portal/config.js from 'ports' to 'subdomains'.
PORTAL_PORT=80

RACK_PORT=8088
INVENTORY_PORT=8085
SCAN_PORT=7734
PROVISION_PORT=8080
KICK_PORT=8000

# Only used once you are on a real domain (Caddy's subdomain routes and the
# links the portal builds in 'subdomains' mode). Ignore it while browsing by IP.
SUITE_DOMAIN=swsuite.lan

# Where file-based app data lives on the host. Back this directory up.
SUITE_DATA=./data

# ── SWRack ───────────────────────────────────────────────────────────────────
POSTGRES_DB=cabinet_canvas
POSTGRES_USER=cabinet_canvas
POSTGRES_PASSWORD=change-me-now
MAX_UPLOAD_MB=10
# The UI proxies /api internally, so the browser never makes a cross-origin
# call. Left permissive; tighten it if you ever expose the API directly.
RACK_CORS_ORIGIN=*

# ── SWOps ─────────────────────────────────────────────────────────
INVENTORY_SECRET_KEY=change-me-in-production
# Printed QR codes encode this address, so it must be one that other devices on
# the network can actually open. ORIGIN ONLY, no path -- the app appends
# /ops/a/<key> itself. For example:
#   http://192.168.1.254        (by IP)
#   https://suite.example.com       (once NPM serves the domain)
# Changing it does not alter labels already printed.
INVENTORY_BASE_URL=


# ── SWKick ───────────────────────────────────────────────────────────────────
# ./scripts/init-swkick.sh fills in the two secrets below and creates the
# vault master key at ./secrets/swkick-master.key. Back that key up separately
# from ./data: without it the stored SSH credentials cannot be decrypted.
KICK_SESSION_SECRET=
# First-run admin password (user "admin"). Change it in SWKick's Settings.
KICK_BOOTSTRAP_PASSWORD=
KICK_POLL_INTERVAL_HOURS=6

# ── AI provider keys (SWScan) ───────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
